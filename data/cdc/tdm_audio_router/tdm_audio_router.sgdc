current_design tdm_audio_router_top

clock -name tdm_clk -domain tdm_clk -period 10 -edge {0 5.0}
clock -name audio_clk -domain audio_clk -period 13 -edge {0 6.5}
clock -name bus_clk -domain bus_clk -period 16 -edge {0 8.0}

reset -name tdm_rst_n -value 0
reset -name audio_rst_n -value 0
reset -name bus_rst_n -value 0
