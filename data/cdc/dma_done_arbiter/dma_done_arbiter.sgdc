current_design dma_done_arbiter_top

clock -name dma_clk -domain dma_clk -period 10 -edge {0 5.0}
clock -name irq_clk -domain irq_clk -period 13 -edge {0 6.5}
clock -name cfg_clk -domain cfg_clk -period 16 -edge {0 8.0}

reset -name dma_rst_n -value 0
reset -name irq_rst_n -value 0
reset -name cfg_rst_n -value 0
