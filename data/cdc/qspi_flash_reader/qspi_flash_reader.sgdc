current_design qspi_flash_reader_top

clock -name qspi_clk -domain qspi_clk -period 10 -edge {0 5.0}
clock -name ahb_clk -domain ahb_clk -period 13 -edge {0 6.5}
clock -name cfg_clk -domain cfg_clk -period 16 -edge {0 8.0}

reset -name qspi_rst_n -value 0
reset -name ahb_rst_n -value 0
reset -name cfg_rst_n -value 0
