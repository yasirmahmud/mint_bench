current_design sdio_command_top

clock -name sdio_clk -domain sdio_clk -period 10 -edge {0 5.0}
clock -name sys_clk -domain sys_clk -period 13 -edge {0 6.5}
clock -name dma_clk -domain dma_clk -period 16 -edge {0 8.0}

reset -name sdio_rst_n -value 0
reset -name sys_rst_n -value 0
reset -name dma_rst_n -value 0
