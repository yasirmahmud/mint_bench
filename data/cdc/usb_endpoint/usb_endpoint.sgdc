current_design usb_endpoint_top

clock -name usb_clk -domain usb_clk -period 10 -edge {0 5.0}
clock -name sys_clk -domain sys_clk -period 13 -edge {0 6.5}
clock -name debug_clk -domain debug_clk -period 16 -edge {0 8.0}

reset -name usb_rst_n -value 0
reset -name sys_rst_n -value 0
reset -name debug_rst_n -value 0
