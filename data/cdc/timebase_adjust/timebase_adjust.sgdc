current_design timebase_adjust_top

clock -name rtc_clk -domain rtc_clk -period 10 -edge {0 5.0}
clock -name cpu_clk -domain cpu_clk -period 13 -edge {0 6.5}
clock -name aon_clk -domain aon_clk -period 16 -edge {0 8.0}

reset -name rtc_rst_n -value 0
reset -name cpu_rst_n -value 0
reset -name aon_rst_n -value 0
