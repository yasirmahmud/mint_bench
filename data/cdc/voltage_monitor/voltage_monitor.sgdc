current_design voltage_monitor_top

clock -name volt_clk -domain volt_clk -period 10 -edge {0 5.0}
clock -name pmu_clk -domain pmu_clk -period 13 -edge {0 6.5}
clock -name sys_clk -domain sys_clk -period 16 -edge {0 8.0}

reset -name volt_rst_n -value 0
reset -name pmu_rst_n -value 0
reset -name sys_rst_n -value 0
