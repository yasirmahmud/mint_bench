current_design multi_protocol_cdc_hazards_top

clock -name cfg_clk -domain cfg_clk -period 10 -edge {0 5.0}
clock -name axi_clk -domain axi_clk -period 13 -edge {0 6.5}
clock -name sensor_clk -domain sensor_clk -period 16 -edge {0 8.0}
clock -name dsp_clk -domain dsp_clk -period 19 -edge {0 9.5}
clock -name mem_clk -domain mem_clk -period 22 -edge {0 11.0}
clock -name debug_clk -domain debug_clk -period 25 -edge {0 12.5}
clock -name scan_clk -domain scan_clk -period 28 -edge {0 14.0}

reset -name cfg_rst_n -value 0
reset -name axi_rst_n -value 0
reset -name sensor_rst_n -value 0
reset -name dsp_rst_n -value 0
reset -name mem_rst_n -value 0
reset -name debug_rst_n -value 0
