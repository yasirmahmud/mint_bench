current_design mailbox_apb_top

clock -name apb_clk -domain apb_clk -period 10 -edge {0 5.0}
clock -name mailbox_clk -domain mailbox_clk -period 13 -edge {0 6.5}
clock -name irq_clk -domain irq_clk -period 16 -edge {0 8.0}

reset -name apb_rst_n -value 0
reset -name mailbox_rst_n -value 0
reset -name irq_rst_n -value 0
