current_design timer_capture_top

clock -name timer_clk -domain timer_clk -period 10 -edge {0 5.0}
clock -name apb_clk -domain apb_clk -period 13 -edge {0 6.5}
clock -name trace_clk -domain trace_clk -period 16 -edge {0 8.0}

reset -name timer_rst_n -value 0
reset -name apb_rst_n -value 0
reset -name trace_rst_n -value 0
