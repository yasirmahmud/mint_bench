current_design trace_funnel_top

clock -name trace_clk -domain trace_clk -period 10 -edge {0 5.0}
clock -name fabric_clk -domain fabric_clk -period 13 -edge {0 6.5}
clock -name debug_clk -domain debug_clk -period 16 -edge {0 8.0}

reset -name trace_rst_n -value 0
reset -name fabric_rst_n -value 0
reset -name debug_rst_n -value 0
