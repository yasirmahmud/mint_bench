current_design memory_scrubber_top

clock -name mem_clk -domain mem_clk -period 10 -edge {0 5.0}
clock -name ctrl_clk -domain ctrl_clk -period 13 -edge {0 6.5}
clock -name diag_clk -domain diag_clk -period 16 -edge {0 8.0}

reset -name mem_rst_n -value 0
reset -name ctrl_rst_n -value 0
reset -name diag_rst_n -value 0
