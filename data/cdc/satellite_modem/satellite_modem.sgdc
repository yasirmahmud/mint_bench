current_design satellite_modem_top

clock -name modem_clk -domain modem_clk -period 10 -edge {0 5.0}
clock -name host_clk -domain host_clk -period 13 -edge {0 6.5}
clock -name rf_clk -domain rf_clk -period 16 -edge {0 8.0}

reset -name modem_rst_n -value 0
reset -name host_rst_n -value 0
reset -name rf_rst_n -value 0
