current_design gpio_wakeup_top

clock -name gpio_clk -domain gpio_clk -period 10 -edge {0 5.0}
clock -name pmu_clk -domain pmu_clk -period 13 -edge {0 6.5}
clock -name aon_clk -domain aon_clk -period 16 -edge {0 8.0}

reset -name gpio_rst_n -value 0
reset -name pmu_rst_n -value 0
reset -name aon_rst_n -value 0
