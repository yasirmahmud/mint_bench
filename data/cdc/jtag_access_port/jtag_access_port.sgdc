current_design jtag_access_port_top

clock -name jtag_clk -domain jtag_clk -period 10 -edge {0 5.0}
clock -name system_clk -domain system_clk -period 13 -edge {0 6.5}
clock -name trace_clk -domain trace_clk -period 16 -edge {0 8.0}

reset -name jtag_rst_n -value 0
reset -name system_rst_n -value 0
reset -name trace_rst_n -value 0
