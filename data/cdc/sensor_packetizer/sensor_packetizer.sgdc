current_design sensor_packetizer_top

clock -name sensor_clk -domain sensor_clk -period 10 -edge {0 5.0}
clock -name fabric_clk -domain fabric_clk -period 13 -edge {0 6.5}
clock -name cfg_clk -domain cfg_clk -period 16 -edge {0 8.0}

reset -name sensor_rst_n -value 0
reset -name fabric_rst_n -value 0
reset -name cfg_rst_n -value 0
