current_design pll_lock_monitor_top

clock -name pll_clk -domain pll_clk -period 10 -edge {0 5.0}
clock -name sys_clk -domain sys_clk -period 13 -edge {0 6.5}
clock -name cfg_clk -domain cfg_clk -period 16 -edge {0 8.0}

reset -name pll_rst_n -value 0
reset -name sys_rst_n -value 0
reset -name cfg_rst_n -value 0
