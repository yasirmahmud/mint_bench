current_design low_power_island_top

clock -name aon_clk -domain aon_clk -period 10 -edge {0 5.0}
clock -name island_clk -domain island_clk -period 13 -edge {0 6.5}
clock -name sys_clk -domain sys_clk -period 16 -edge {0 8.0}

reset -name aon_rst_n -value 0
reset -name island_rst_n -value 0
reset -name sys_rst_n -value 0
