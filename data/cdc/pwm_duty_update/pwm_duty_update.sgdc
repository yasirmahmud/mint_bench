current_design pwm_duty_update_top

clock -name cfg_clk -domain cfg_clk -period 10 -edge {0 5.0}
clock -name pwm_clk -domain pwm_clk -period 13 -edge {0 6.5}
clock -name aon_clk -domain aon_clk -period 16 -edge {0 8.0}

reset -name cfg_rst_n -value 0
reset -name pwm_rst_n -value 0
reset -name aon_rst_n -value 0
