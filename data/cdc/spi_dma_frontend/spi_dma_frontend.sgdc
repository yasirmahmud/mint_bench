current_design spi_dma_frontend_top

clock -name spi_clk -domain spi_clk -period 10 -edge {0 5.0}
clock -name dma_clk -domain dma_clk -period 13 -edge {0 6.5}
clock -name cfg_clk -domain cfg_clk -period 16 -edge {0 8.0}

reset -name spi_rst_n -value 0
reset -name dma_rst_n -value 0
reset -name cfg_rst_n -value 0
