current_design ddr_refresh_ctrl_top

clock -name ddr_clk -domain ddr_clk -period 10 -edge {0 5.0}
clock -name ctrl_clk -domain ctrl_clk -period 13 -edge {0 6.5}
clock -name apb_clk -domain apb_clk -period 16 -edge {0 8.0}

reset -name ddr_rst_n -value 0
reset -name ctrl_rst_n -value 0
reset -name apb_rst_n -value 0
