current_design cdc_smoke_top

clock -name src_clk -domain src_clk -period 10 -edge {0 5}
clock -name dst_clk -domain dst_clk -period 13 -edge {0 6.5}
clock -name aux_clk -domain aux_clk -period 17 -edge {0 8.5}

reset -name src_rst_n -value 0
reset -name dst_rst_n -value 0
reset -name aux_rst_n -value 0
reset -name dst_async_reset_n -value 0
